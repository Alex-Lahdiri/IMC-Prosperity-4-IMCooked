def relu(vec: List[float]) -> List[float]:
    return [x if x > 0.0 else 0.0 for x in vec]

def dot(a: List[float], b: List[float]) -> float:
    s = 0.0
    for x, y in zip(a, b):
        s += x * y
    return s

def linear(x: List[float], W: List[List[float]], b: List[float]) -> List[float]:
    return [dot(row, x) + bias for row, bias in zip(W, b)]

def scale_features(x: List[float], mean: List[float], scale: List[float]) -> List[float]:
    out = []
    for xi, m, s in zip(x, mean, scale):
        denom = s if abs(s) > 1e-12 else 1.0
        out.append((xi - m) / denom)
    return out

def forward_mlp_18_256_128_64_1(
    x: List[float],
    mean: List[float],
    scale: List[float],
    W1: List[List[float]], B1: List[float],
    W2: List[List[float]], B2: List[float],
    W3: List[List[float]], B3: List[float],
    W4: List[List[float]], B4: List[float],
) -> float:
    x = scale_features(x, mean, scale)
    a1 = relu(linear(x, W1, B1))
    a2 = relu(linear(a1, W2, B2))
    a3 = relu(linear(a2, W3, B3))
    out = linear(a3, W4, B4)
    return out[0]


