class Trader:
    def run(self, state: TradingState):
        result: Dict[Symbol, List[Order]] = {}

        trader_state: Dict[str, Any] = {}
        if state.traderData:
            try:
                trader_state = json.loads(state.traderData)
            except Exception:
                trader_state = {}

        for product, order_depth in state.order_depths.items():
            position = state.position.get(product, 0)
            limit = POSITION_LIMITS.get(product, 50)
            orders: List[Order] = []

            if product in ("ASH_COATED_OSMIUM", "INTARIAN_PEPPER_ROOT"):
                orders, trader_state = self.trade_mlp_product(
                    product, order_depth, position, limit, state, trader_state
                )

            result[product] = orders

        trader_data = json.dumps(trader_state)
        conversions = 0
        logger.flush(state, result, conversions, trader_data)
        return result, conversions, trader_data

    def trade_mlp_product(
        self,
        product: str,
        od: OrderDepth,
        position: int,
        limit: int,
        state: TradingState,
        trader_state: Dict[str, Any],
    ) -> tuple[List[Order], Dict[str, Any]]:
        orders: List[Order] = []

        best_bid = max(od.buy_orders.keys()) if od.buy_orders else None
        best_ask = min(od.sell_orders.keys()) if od.sell_orders else None

        if best_bid is None and best_ask is None:
            return orders, trader_state

        if best_bid is not None and best_ask is not None:
            mid_price = 0.5 * (best_bid + best_ask)
        elif best_bid is not None:
            mid_price = float(best_bid)
        else:
            mid_price = float(best_ask)

        # Skip cursed snapshots
        if mid_price <= 0:
            return orders, trader_state

        bid_price_1 = float(best_bid) if best_bid is not None else mid_price
        ask_price_1 = float(best_ask) if best_ask is not None else mid_price

        bid_volume_1 = float(od.buy_orders.get(best_bid, 0)) if best_bid is not None else 0.0
        ask_volume_1 = float(-od.sell_orders.get(best_ask, 0)) if best_ask is not None else 0.0

        buy_prices_desc = sorted(od.buy_orders.keys(), reverse=True)
        sell_prices_asc = sorted(od.sell_orders.keys())

        def get_level(side_prices: List[int], level: int, side_dict: Dict[int, int], is_sell: bool) -> tuple[float, float]:
            if level < len(side_prices):
                px = float(side_prices[level])
                qty_raw = side_dict[side_prices[level]]
                qty = float(-qty_raw if is_sell else qty_raw)
                return px, qty
            return mid_price, 0.0

        bid_price_2, bid_volume_2 = get_level(buy_prices_desc, 1, od.buy_orders, False)
        bid_price_3, bid_volume_3 = get_level(buy_prices_desc, 2, od.buy_orders, False)
        ask_price_2, ask_volume_2 = get_level(sell_prices_asc, 1, od.sell_orders, True)
        ask_price_3, ask_volume_3 = get_level(sell_prices_asc, 2, od.sell_orders, True)

        # Current tick market trades
        trades = state.market_trades.get(product, [])
        if trades:
            trade_count = float(len(trades))
            trade_qty = float(sum(abs(t.quantity) for t in trades))
            trade_value = float(sum(float(t.price) * abs(t.quantity) for t in trades))
            trade_vwap = trade_value / max(trade_qty, 1e-6)
        else:
            trade_count = 0.0
            trade_qty = 0.0
            trade_vwap = mid_price

        spread = ask_price_1 - bid_price_1
        imbalance = bid_volume_1 - ask_volume_1
        imbalance_ratio = imbalance / (bid_volume_1 + ask_volume_1 + 1e-6)

        microprice = (
            ask_price_1 * bid_volume_1 + bid_price_1 * ask_volume_1
        ) / (bid_volume_1 + ask_volume_1 + 1e-6)

        micro_diff = microprice - mid_price
        mid_minus_vwap = mid_price - trade_vwap

        total_bid_vol_3 = bid_volume_1 + bid_volume_2 + bid_volume_3
        total_ask_vol_3 = ask_volume_1 + ask_volume_2 + ask_volume_3
        book_imbalance_3 = (
            (total_bid_vol_3 - total_ask_vol_3) /
            (total_bid_vol_3 + total_ask_vol_3 + 1e-6)
        )

        prev_key = f"{product}_prev"
        prev = trader_state.get(prev_key, {})
        prev_mid = float(prev.get("mid_price", mid_price))
        prev_spread = float(prev.get("spread", spread))
        prev_imbalance_ratio = float(prev.get("imbalance_ratio", imbalance_ratio))

        prev_mid_change = mid_price - prev_mid

        x = [
            bid_price_1, bid_volume_1,
            ask_price_1, ask_volume_1,
            trade_count, trade_qty, trade_vwap,
            spread, imbalance, imbalance_ratio,
            micro_diff, mid_minus_vwap,
            total_bid_vol_3, total_ask_vol_3, book_imbalance_3,
            prev_mid_change, prev_spread, prev_imbalance_ratio,
        ]

        if product == "ASH_COATED_OSMIUM":
            pred_delta = forward_mlp_18_256_128_64_1(
                x,
                OSMIUM_MEAN, OSMIUM_SCALE,
                OSMIUM_W1, OSMIUM_B1,
                OSMIUM_W2, OSMIUM_B2,
                OSMIUM_W3, OSMIUM_B3,
                OSMIUM_W4, OSMIUM_B4,
            )
        else:
            pred_delta = forward_mlp_18_256_128_64_1(
                x,
                ROOT_MEAN, ROOT_SCALE,
                ROOT_W1, ROOT_B1,
                ROOT_W2, ROOT_B2,
                ROOT_W3, ROOT_B3,
                ROOT_W4, ROOT_B4,
            )

        predicted_fair = mid_price + pred_delta
        buy_threshold = BUY_THRESHOLD[product]
        sell_threshold = SELL_THRESHOLD[product]
        half_spread = PASSIVE_HALF_SPREAD[product]

        logger.print(
            f"{product} mid={mid_price:.2f} pred_delta={pred_delta:.4f} fair={predicted_fair:.2f} pos={position}"
        )

        # ── 1. Aggressive taking on strong signal ─────────────────
        if od.sell_orders and pred_delta > buy_threshold:
            max_buy = limit - position
            for ask_px in sorted(od.sell_orders.keys()):
                ask_qty_available = -od.sell_orders[ask_px]
                if ask_px < predicted_fair and max_buy > 0:
                    qty = min(max_buy, ask_qty_available)
                    if qty > 0:
                        orders.append(Order(product, ask_px, qty))
                        position += qty
                        max_buy -= qty

        if od.buy_orders and pred_delta < sell_threshold:
            max_sell = limit + position
            for bid_px in sorted(od.buy_orders.keys(), reverse=True):
                bid_qty_available = od.buy_orders[bid_px]
                if bid_px > predicted_fair and max_sell > 0:
                    qty = min(max_sell, bid_qty_available)
                    if qty > 0:
                        orders.append(Order(product, bid_px, -qty))
                        position -= qty
                        max_sell -= qty

        # ── 2. Passive quoting with simple signal logic ──────────
        inv_skew = -0.15 * position
        inv_skew = max(-2.0, min(2.0, inv_skew))

        quote_fair = predicted_fair + inv_skew
        bid_quote = int(round(quote_fair - half_spread))
        ask_quote = int(round(quote_fair + half_spread))

        remaining_buy = limit - position
        remaining_sell = limit + position

        abs_signal = min(abs(pred_delta), MAX_SIGNAL_CLIP)
        intensity = abs_signal / MAX_SIGNAL_CLIP
        base_size = max(1, int(limit * 0.20))
        sized_qty = max(1, int(base_size + intensity * base_size))

        if pred_delta > buy_threshold and remaining_buy > 0:
            qty = min(remaining_buy, sized_qty)
            orders.append(Order(product, bid_quote, qty))

        if pred_delta < sell_threshold and remaining_sell > 0:
            qty = min(remaining_sell, sized_qty)
            orders.append(Order(product, ask_quote, -qty))

        trader_state[prev_key] = {
            "mid_price": mid_price,
            "spread": spread,
            "imbalance_ratio": imbalance_ratio,
        }

        return orders, trader_state